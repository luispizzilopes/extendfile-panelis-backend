# Variáveis de ambiente para o backend Panelis
# Copie este arquivo para .env e preencha os valores reais.

# Banco de dados
CONNECTION_STRING=Host=localhost;Port=5432;Database=panelis;Username=postgres;Password=

# E-mail (recuperação de senha)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Panelis
